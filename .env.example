# Backend startup and administrator commands load .env from the working directory.
# Existing shell/deployment variables take precedence over .env.
MONGODB_URI=mongodb://127.0.0.1:27017/payroll_db
PORT=3000
FRONTEND_ORIGIN=http://localhost:4200
# Required: generate independently, at least 32 random characters. Never commit it.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Paste your generated value into your private .env, not this example.
SESSION_SECRET=
NODE_ENV=development
# Set only behind a trusted proxy; omit for direct local connections.
TRUST_PROXY_HOPS=
# Operator bootstrap/recovery commands only; do not retain in deployed environments.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
